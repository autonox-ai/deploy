# Required by deploy/workloads/import/import.sh. Copy and edit this file.
TENANT_ID=local
ENVIRONMENT=test
WORKSPACE_ID=hello
SYSTEM_INSTANCE_ID=mock-hr
TARGET_REF=t1
CONTAINER_RUNTIME=docker
COLLECTOR_IMAGE=registry.example/autonox-collectors@sha256:replace-with-64-hex-digits
WAREHOUSE_IMAGE=registry.example/autonox-warehouse@sha256:replace-with-64-hex-digits
RECONCILE_IMAGE=registry.example/autonox-reconciliation@sha256:replace-with-64-hex-digits
RECEIPT_DIR=/absolute/path/to/testkit/receipts
ARTIFACT_URI_PREFIX=shared://local/imports
ARTIFACT_HOST_ROOT=/absolute/path/to/testkit/artifacts
COLLECTOR_ARTIFACT_PATH_PREFIX=/output
WAREHOUSE_ARTIFACT_PATH_PREFIX=/output
RECONCILE_ARTIFACT_PATH_PREFIX=/output
COLLECTOR_SPEC=/absolute/path/to/config/collector.yaml
CONNECTION_CATALOG=/absolute/path/to/config/connections.yaml
COLLECTOR_ROOT_URI=/output
WAREHOUSE_WIRING=/absolute/path/to/config/warehouse-wiring.yaml
FLOW_SPEC=/absolute/path/to/config/flow.yaml
BANDING_SPEC=/absolute/path/to/config/banding.yaml
RECONCILE_WIRING=/absolute/path/to/config/reconcile.yaml
COLLECTOR_CONTAINER_VOLUMES=$'/absolute/path/to/artifacts:/output:Z\n/absolute/path/to/config:/absolute/path/to/config:ro'
COLLECTOR_CONTAINER_RUN_ARGS=$'--platform\nlinux/amd64\n--network\nautonox-local'
WAREHOUSE_CONTAINER_VOLUMES=$'/absolute/path/to/artifacts:/output:Z\n/absolute/path/to/config:/absolute/path/to/config:ro'
WAREHOUSE_CONTAINER_RUN_ARGS=$'--platform\nlinux/amd64\n--network\nautonox-local'
RECONCILE_CONTAINER_VOLUMES=$'/absolute/path/to/artifacts:/output:Z\n/absolute/path/to/config:/absolute/path/to/config:ro'
RECONCILE_CONTAINER_RUN_ARGS=$'--platform\nlinux/amd64\n--network\nautonox-local'

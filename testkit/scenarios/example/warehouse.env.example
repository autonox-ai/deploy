# Optional override for deploy/workloads/warehouse/run.sh. The default
# `deploy/testkit/run.sh migrate` generates an equivalent local environment.
CONTAINER_RUNTIME=docker
CONTAINER_NETWORK=autonox-local
WAREHOUSE_PLATFORM=linux/amd64
WAREHOUSE_IMAGE=ghcr.io/autonox-ai/autonox-warehouse:replace-with-manifest-reference
WAREHOUSE_CONFIG_DIR=/absolute/path/to/deploy/testkit/scenarios/example/config
WAREHOUSE_WIRING_PATH=/config/warehouse-wiring.yaml
WAREHOUSE_CANONICAL_WIRING_PATH=/config/warehouse-canonical-wiring.yaml
WAREHOUSE_POSTGRES_DSN=postgresql://noxop:local-noxop@postgres:5432/autonox
WORKSPACE_ID=hello

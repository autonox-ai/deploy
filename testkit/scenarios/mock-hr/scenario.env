# Scenario manifest, sourced by testkit/init.sh and testkit/run.sh.
#
# This is the scenario's half of the contract: identity and run shape. The
# harness owns everything else (image resolution, mounts, artifact and receipt
# paths, DSNs). Adding a scenario means adding a directory with this file —
# no harness edits.
#
# WORKSPACE_ID must match spec.workspace_id in config/warehouse-wiring.yaml;
# init.sh verifies this and fails if they drift.

WORKSPACE_ID=prod
SYSTEM_INSTANCE_ID=mock_hr
TENANT_ID=local
ENVIRONMENT=test

# Reconciliation target binding, as the runtime expects it.
TARGET_REF=warehouse/ws_prod

# The mocked HR source lands in PostgreSQL via source/*.sql, so the collector
# reaches it over the Compose network and needs no source volume mount.
COMPLETION_POLICY=none

# Copy to $AUTONOX_HOME/metabase.env — not into this repo — and pass it with
#   docker compose -f metabase/compose/compose.yaml \
#     --env-file "$AUTONOX_HOME/metabase.env" up -d
# The copy holds a database password: chmod 600 it.

METABASE_IMAGE=metabase/metabase:v0.58.22
METABASE_DOCKER_NETWORK=autonox-local

# --- database ---------------------------------------------------------------
# Must match the values used with metabase/bootstrap/setup.sql.tmpl:
#   METABASE_DB       -> MB_DB_DBNAME
#   METABASE_USER     -> MB_DB_USER
#   METABASE_PASSWORD -> MB_DB_PASS
# MB_DB_PASS ships empty on purpose — no baked-in secrets. Compose refuses to
# start until it is set.
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_PORT=5432
MB_DB_USER=metabase_user
MB_DB_PASS=
MB_DB_HOST=postgres

# --- TLS / proxy ------------------------------------------------------------
# Metabase is reached through Traefik over HTTPS only; there is no plaintext
# mode. Everything below has a working default — a stock run needs no changes.

# The public name of this host. Used for the self-signed certificate's subject
# and SAN, and for MB_SITE_URL. Set it to the name users will actually type
# (an IP address is fine) so the certificate matches; otherwise browsers add a
# name-mismatch error on top of the untrusted-issuer one.
METABASE_HOSTNAME=localhost

# Where tls.crt / tls.key live on the host. A self-signed pair is generated
# here on first start if the directory has none. To use the customer's own
# certificate, drop the full chain (leaf first, then intermediates) and its key
# in as tls.crt / tls.key — see compose/README.md.
#
# Defaults to $AUTONOX_HOME/certs, so it follows the rest of the customer's
# configuration with nothing to set. AUTONOX_HOME is read from the shell that
# runs `docker compose` or from this file (the shell wins); if it is set in
# neither, the fallback is /etc/autonox/certs, which a non-root engine cannot
# create. Uncomment whichever of these applies.
# AUTONOX_HOME=/home/nox/.autonox
# METABASE_TLS_DIR=/home/nox/.autonox/certs

# Extra SANs for the generated certificate when the host answers to more than
# one name. openssl syntax, comma separated. The hostname above, localhost and
# 127.0.0.1 are always included.
# METABASE_TLS_SANS=DNS:bi.corp.example,IP:10.0.0.7

# Published proxy ports. Change these only if something else on the host
# already owns 80/443.
METABASE_HTTP_PORT=80
METABASE_HTTPS_PORT=443

# Required only when METABASE_HTTPS_PORT is not 443, so that the HTTP->HTTPS
# redirect points at the port Traefik is actually published on. Include the
# colon.
# METABASE_HTTPS_REDIRECT_TO=:8443

# Set explicitly when METABASE_HTTPS_PORT is not 443 — Metabase puts this URL
# in emails and public links, and the port has to be part of it.
# MB_SITE_URL=https://bi.corp.example:8443

# Metabase's own port. Published on loopback only, for host-side tooling
# (terraform from metabase/tf, curl). Set METABASE_BIND_ADDRESS=0.0.0.0 only if
# something really has to reach Metabase without going through TLS.
METABASE_PORT=3000
METABASE_BIND_ADDRESS=127.0.0.1

TRAEFIK_IMAGE=traefik:v3.7.9
TRAEFIK_LOG_LEVEL=INFO

# Copy to $AUTONOX_HOME/metabase.env — not into this repo — and pass it with
#   docker compose -f metabase/compose/compose.yaml \
#     --env-file "$AUTONOX_HOME/metabase.env" up -d
# The copy holds a database password: chmod 600 it.

METABASE_IMAGE=metabase/metabase:v0.58.22
METABASE_PORT=3000
METABASE_DOCKER_NETWORK=autonox-local

# Must match the values used with metabase/bootstrap/setup.sql.tmpl:
#   METABASE_DB       -> MB_DB_DBNAME
#   METABASE_USER     -> MB_DB_USER
#   METABASE_PASSWORD -> MB_DB_PASS
# MB_DB_PASS ships empty on purpose — no baked-in secrets. Compose refuses to
# start until it is set.
MB_DB_TYPE=postgres
MB_DB_DBNAME=metabase
MB_DB_PORT=5432
MB_DB_USER=metabase_user
MB_DB_PASS=
MB_DB_HOST=postgres

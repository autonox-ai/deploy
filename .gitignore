# OS
.DS_Store

# Editors
.idea/
.vscode/

# Temporary / local
*.swp
*.tmp
*.log

# Secrets (never commit)
*.secret.yaml
*.secrets.yaml
.env
.env.*
!.env.example
# Customer config belongs in $AUTONOX_HOME, never in this tree.
*.env
!*.env.example
# Testkit scenario manifests are fixtures, not customer config.
!testkit/scenarios/*/scenario.env

# Terraform
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars
metabase/tf/provider-mirror

# Nothing generated belongs in this tree: writable paths resolve to
# $AUTONOX_HOME, and air-gap bundles take an explicit directory. Deliberately
# NOT ignoring tmp/ or tars/ — if either reappears, `git status` should say so.

# Import workload settings, consumed by import.sh.
#
# ONE IMPORT RUN IMPORTS ONE SOURCE SYSTEM. A deployment that collects from HR,
# Active Directory and Entra runs import.sh three times, and roughly a third of
# the settings below differ on each run. So this is not one file per host — it
# is a deployment-wide part plus a per-source part, and the sections below are
# split that way.
#
# Layer them rather than copying. run-import.sh does this composition for you,
# in an erased environment so nothing leaks between two sources run back to
# back, and is what a scheduler should invoke:
#
#   AUTONOX_HOME=/etc/autonox ./run-import.sh entra start
#
#   /etc/autonox/images.env             image digests, shared with the
#                                       warehouse workload
#   /etc/autonox/import.env             the deployment-wide half
#   /etc/autonox/sources/entra.env      the per-source half
#
# By hand, without the wrapper, it is `set -a; source …; source …; set +a`
# followed by ./import.sh start — but do it in a fresh shell each time, since
# sourcing accumulates and a previous source's settings survive.
#
# 21 settings are required. import.sh checks all of them before starting any
# container, so a missing one fails immediately rather than three tasks in.
#
# The tag on each setting says WHO CONSUMES IT — the question worth answering
# when a task fails:
#
#   [driver]         import.sh only; never reaches a container
#   [collector]      passed to the Collector image
#   [warehouse]      passed to the Warehouse image (bronze + silver)
#   [reconciliation] passed to the Reconciliation image
#
# A [driver] setting cannot break a tool. It can only mislabel a receipt or
# misdirect a path.


# ════════════════════════════════════════════════════════════════════════════
# IMAGES — change on every upgrade, so keep them in their own file
# ════════════════════════════════════════════════════════════════════════════
#
# Must be immutable digest references; import.sh rejects a tag outright.
# images/manifest.txt pins tags, not digests. Resolve them on a connected host:
#
#   docker image inspect --format '{{index .RepoDigests 0}}' <tag>
#
# On an air-gapped host this yields nothing — images loaded from a tar carry no
# RepoDigests. Take the digests from column 3 of the bundle.lock written by
# images/airgap/pull-and-save.sh on the connected side.
#
# images/resolve-digests.sh writes all three, and workloads/warehouse reads
# WAREHOUSE_IMAGE from the same file — so one images.env covers both workloads.

COLLECTOR_IMAGE=registry.example/collectors@sha256:replace-with-64-hex-digits
WAREHOUSE_IMAGE=registry.example/warehouse@sha256:replace-with-64-hex-digits
RECONCILE_IMAGE=registry.example/reconciliation@sha256:replace-with-64-hex-digits


# ════════════════════════════════════════════════════════════════════════════
# DEPLOYMENT-WIDE — identical for every source imported into this workspace
# ════════════════════════════════════════════════════════════════════════════

# ── Identity ────────────────────────────────────────────────────────────────

# [driver] Labels. Written to the receipt and sent nowhere else, so a receipt
# stays self-describing once it leaves this host — one archive can hold
# receipts from several customers and environments. Nothing validates them.
TENANT_ID=customer-a
ENVIRONMENT=production

# [warehouse] [reconciliation] The data plane. Passed as --workspace-id to every
# bronze and silver command and to the reconciliation evidence query. The schema
# ws_<WORKSPACE_ID> must already exist and be migrated — see postgres/bootstrap
# and workloads/warehouse — and this must equal the WORKSPACE_ID that workload
# migrated with.
WORKSPACE_ID=customer-a-prod

# [reconciliation] Passed as --target-ref. Must be a key in the reconcile
# wiring's target_mapping or reconcile_validate fails. It identifies the
# destination, not the source, so every source importing into this workspace
# uses the same value. Convention is warehouse/ws_<WORKSPACE_ID>; the wiring
# decides, nothing enforces it.
TARGET_REF=warehouse/ws_customer-a-prod

# [driver] Defaults to docker. Set to podman where that is the runtime.
CONTAINER_RUNTIME=docker


# ── Receipts and artifacts ──────────────────────────────────────────────────

# [driver] Where receipts are written, one directory per orchestration run.
# Must already exist. This is durable audit evidence and the only thing that
# makes a run resumable — do not point it at scratch space.
RECEIPT_DIR=/srv/autonox/import-receipts

# [driver] Artifacts are addressed by URI, not by path, so a receipt stays
# meaningful on a host with different mounts. These two are halves of one
# mapping: every artifact URI must begin with the prefix, and the remainder
# resolves under the host root. No trailing slash on the prefix.
ARTIFACT_URI_PREFIX=shared://customer-a/imports
ARTIFACT_HOST_ROOT=/srv/autonox/import-artifacts

# The container-side end of that mapping, per tool — where each image sees
# ARTIFACT_HOST_ROOT mounted. They may differ if an image insists on its own
# layout; each must agree with that tool's *_CONTAINER_VOLUMES entry.
COLLECTOR_ARTIFACT_PATH_PREFIX=/output
WAREHOUSE_ARTIFACT_PATH_PREFIX=/output
RECONCILE_ARTIFACT_PATH_PREFIX=/output


# ── Warehouse and reconciliation ────────────────────────────────────────────
# Both are addressed to the workspace, not to a source, so they are shared.

# [warehouse] The same runtime wiring document the warehouse workload migrates
# with. Point both at one file — a second copy is how a deployment ends up
# migrating one workspace and importing into another.
WAREHOUSE_WIRING=/etc/autonox/warehouse-config/warehouse-wiring.yaml

# [reconciliation] Target mapping, connection catalog, materialization catalog
# and control-plane store for the apply phase. Keyed by TARGET_REF, which does
# not vary by source, so one document serves every source.
RECONCILE_WIRING=/etc/autonox/config/reconcile.yaml

# Credentials reach containers by NAME — import.sh passes the names, never the
# values, and records only the names in the receipt. Export the values from a
# secret manager in production, not from a file on disk.
WAREHOUSE_POSTGRES_DSN=postgresql://noxop:CHANGE_ME@postgres:5432/autonox
WAREHOUSE_CONTAINER_ENV_NAMES=WAREHOUSE_POSTGRES_DSN

RECONCILE_POSTGRES_DSN=$WAREHOUSE_POSTGRES_DSN
RECONCILE_WAREHOUSE_DSN=$WAREHOUSE_POSTGRES_DSN
RECONCILE_CONTAINER_ENV_NAMES=$'RECONCILE_POSTGRES_DSN\nRECONCILE_WAREHOUSE_DSN'

# Newline-delimited, one entry per line. Each tool needs the artifact root plus
# every configuration document it reads. Receipts keep mount destinations but
# redact host-side sources and run arguments.
WAREHOUSE_CONTAINER_RUN_ARGS=--userns=keep-id
WAREHOUSE_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/etc/autonox/config:/etc/autonox/config:ro\n/etc/autonox/warehouse-config:/etc/autonox/warehouse-config:ro'

RECONCILE_CONTAINER_RUN_ARGS=--userns=keep-id
RECONCILE_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/etc/autonox/config:/etc/autonox/config:ro'


# ════════════════════════════════════════════════════════════════════════════
# PER-SOURCE — one set per system you collect from (HR, AD, Entra, …)
# ════════════════════════════════════════════════════════════════════════════
# Everything below describes ONE source. Keep a file per source and layer it
# over the section above. The example is an Entra directory.

# [warehouse] Passed as --system-instance-id to `silver run`. Identifies which
# instance of a source system these records came from — one deployment may have
# two Active Directory forests or a test and a production Entra tenant.
#
# It is NOT the banding key. Banding looks up the `source` value the flow spec
# stamps on canonical rows, which is a separate name. Keeping the two identical
# is a sensible convention and makes the config easier to read, but nothing
# enforces it, and a mismatch between the flow spec and the banding spec is the
# one that silently produces empty attributes (TODO.md 3).
SYSTEM_INSTANCE_ID=entra_prod

# [collector] What to collect and how to reach it. The spec is specific to this
# source system. The connection catalog may be shared across sources — it is a
# catalog — as long as it carries an entry the spec references.
COLLECTOR_SPEC=/etc/autonox/config/entra-collector.yaml
CONNECTION_CATALOG=/etc/autonox/config/connections.yaml

# [collector] Root URI the collector writes output under. Normally identical to
# COLLECTOR_ARTIFACT_PATH_PREFIX.
COLLECTOR_ROOT_URI=/output

# [warehouse] Read by `silver run`. The flow spec maps this source's records to
# canonical shape and is therefore per-source. The banding spec decides which
# attributes identify a person and how records from different sources collapse
# into one identity — it is keyed by system_instance_id, so a single document
# can cover every source, and sharing it is what makes cross-source identity
# resolution work.
FLOW_SPEC=/etc/autonox/config/entra-flow.yaml
BANDING_SPEC=/etc/autonox/config/banding.yaml

# [driver] Defaults to observed_converged: after the apply, query the execution
# group and require it to have converged. Set to none when this source produces
# nothing to converge on — an identity feed that grants no access emits no
# accounts, so the query has no subject. A source that does grant access
# (a directory, an application) should keep the default.
COMPLETION_POLICY=observed_converged

# [collector] This source's credentials and mounts. Scoped deliberately: an
# Oracle collector receives its wallet and TNS_ADMIN without the warehouse or
# reconciliation images seeing either.
GRAPH_CLIENT_SECRET=CHANGE_ME
COLLECTOR_CONTAINER_ENV_NAMES=GRAPH_CLIENT_SECRET
COLLECTOR_CONTAINER_RUN_ARGS=--userns=keep-id
COLLECTOR_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/etc/autonox/config:/etc/autonox/config:ro'

# CLI arguments inserted immediately after the image name, before the ones
# import.sh supplies. Needed only when an image's ENTRYPOINT is not already the
# CLI being driven — the sample assumes the Collector needs `collect` prepended
# while Warehouse and Reconciliation do not.
COLLECTOR_COMMAND_ARGS=collect


# ── Optional ────────────────────────────────────────────────────────────────

# import.sh SHA-256s every configuration document and records the hash in the
# receipt, which is what proves later which configuration a run used. That
# requires a readable local file. If a value is a logical URI instead, supply
# the hash yourself — one per document.
# COLLECTOR_SPEC_SHA256=<64 hex>

# Fixes the intents output location instead of the default
# <ARTIFACT_URI_PREFIX>/intents/<preallocated-silver-run-id>.jsonl.
# INTENTS_URI=shared://customer-a/imports/intents/predeclared.jsonl

# [driver] Prints the exact container command (image, --env names, --volume
# entries, --network/--user/etc., trailing CLI args) before running each
# task. Written to the real stderr (fd 3, captured before each task
# redirects fd 2 into its own stderr.log), so it shows up live rather than
# only inside a per-attempt log file. Safe to enable: credentials reach
# containers via --env NAME
# (Docker forwards whatever value that name currently holds; the value itself
# never becomes a literal argument), so nothing this prints can leak a secret
# value — only names, paths and flags. Off by default to keep normal runs
# quiet.
# DEBUG_CONTAINER_COMMANDS=1

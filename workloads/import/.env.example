# Required identity and runtime
TENANT_ID=customer-a
ENVIRONMENT=production
WORKSPACE_ID=customer-a-prod
SYSTEM_INSTANCE_ID=oracle-hr
TARGET_REF=warehouse/ws_customer-a-prod
CONTAINER_RUNTIME=podman

# Images must be immutable references.
COLLECTOR_IMG=registry.example/collectors@sha256:replace-with-64-hex-digits
WAREHOUSE_IMG=registry.example/warehouse@sha256:replace-with-64-hex-digits
RECONCILE_IMG=registry.example/reconciliation@sha256:replace-with-64-hex-digits

# Receipt and shared-artifact storage. ARTIFACT_URI_PREFIX maps to the host
# directory below; each container needs its own corresponding mount.
RECEIPT_DIR=/srv/autonox/import-receipts
ARTIFACT_URI_PREFIX=shared://customer-a/imports
ARTIFACT_HOST_ROOT=/srv/autonox/import-artifacts
COLLECTOR_ARTIFACT_PATH_PREFIX=/output
WAREHOUSE_ARTIFACT_PATH_PREFIX=/output
RECONCILE_ARTIFACT_PATH_PREFIX=/output

# Existing configuration documents (or set the matching *_SHA256 variable if
# the value is a logical URI rather than a runner-local file).
COLLECTOR_SPEC=/srv/autonox/config/oracle-collector.yaml
CONNECTION_CATALOG=/srv/autonox/config/connections.yaml
COLLECTOR_ROOT_URI=/output
WAREHOUSE_WIRING=/srv/autonox/config/warehouse.yaml
FLOW_SPEC=/srv/autonox/config/oracle-flow.yaml
BANDING_SPEC=/srv/autonox/config/banding.yaml
RECONCILE_WIRING=/srv/autonox/config/reconcile.yaml

# The CLI arguments prepended after the image name. One argument per line.
# The sample assumes the Collector image does not have `collect` as ENTRYPOINT;
# Warehouse and Reconciliation do.
COLLECTOR_COMMAND_ARGS=collect

# Container runtime options, secret environment names, and mounts are all
# per-tool and newline-delimited. Values themselves are never recorded.
COLLECTOR_CONTAINER_RUN_ARGS=--userns=keep-id
# Set TNS_ADMIN itself in the runner only when this Collector requires Oracle.
# TNS_ADMIN=/oracle/network/admin
# COLLECTOR_CONTAINER_ENV_NAMES=TNS_ADMIN
COLLECTOR_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/srv/autonox/config:/srv/autonox/config:ro'

WAREHOUSE_CONTAINER_RUN_ARGS=--userns=keep-id
WAREHOUSE_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/srv/autonox/config:/srv/autonox/config:ro'

RECONCILE_CONTAINER_RUN_ARGS=--userns=keep-id
RECONCILE_CONTAINER_VOLUMES=$'/srv/autonox/import-artifacts:/output:Z\n/srv/autonox/config:/srv/autonox/config:ro'

# Optional: fixes the output location instead of the default
# shared://customer-a/imports/intents/<preallocated-silver-run-id>.jsonl.
# INTENTS_URI=shared://customer-a/imports/intents/predeclared.jsonl
# COMPLETION_POLICY=observed_converged

# Warehouse initialization and upgrade workload.
# Copy to .env and set values for this environment. Do not commit .env.

# Container runtime. Set CONTAINER_RUNTIME=podman where appropriate.
CONTAINER_RUNTIME=docker
# Optional, for example: autonox-local. Leave empty when the DSN resolves directly.
CONTAINER_NETWORK=
# Optional container-mount suffix, for example :Z on SELinux hosts.
CONTAINER_MOUNT_SUFFIX=
# Published AutoNox images currently target linux/amd64. Set this on Apple
# Silicon when Docker emulation is available; leave empty for native targets.
WAREHOUSE_PLATFORM=linux/amd64

# Optional JFrog/air-gap override. Otherwise resolved from images/manifest.txt.
# WAREHOUSE_IMAGE=registry.example/autonox-warehouse@sha256:...

# Host directory containing the existing wiring/configuration documents.
WAREHOUSE_CONFIG_DIR=./config
# Paths as seen inside the container after WAREHOUSE_CONFIG_DIR is mounted at /config.
WAREHOUSE_WIRING_PATH=/config/warehouse-wiring.yaml
WAREHOUSE_CANONICAL_WIRING_PATH=/config/warehouse-canonical-wiring.yaml
# Optional path, also inside /config, when wiring uses secret providers.
# WAREHOUSE_SECRETS_PROVIDERS_URI=file:///config/secrets-providers.yaml

# Connection value referenced by the wiring documents.
WAREHOUSE_POSTGRES_DSN=postgresql://noxop:CHANGE_ME@postgres:5432/autonox
# Set when the selected wiring expects this environment value.
WAREHOUSE_CANONICAL_SHARED_SCHEMA=shared

# Required for canonical workspace migration and access-layer installation.
WORKSPACE_ID=

# Additional environment-variable names required by a customer wiring document.
# Values must already be exported or present in this .env file.
# WAREHOUSE_EXTRA_ENV_VARS="EXAMPLE_CERT_PATH"
